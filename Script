-- 2. TẠO CẤU TRÚC GUI VỚI ORION LIBRARY (TÍCH HỢP NÚT PHÓNG TO / THU NHỎ & NÚT X)
local Window = OrionLib:MakeWindow({
    Name = "Steal An Egg | TikTok: lauca", 
    HidePremium = false, 
    SaveConfig = true, 
    ConfigFolder = "StealEggLauCa",
    IntroText = "Steal An Egg Hub - lauca"
})

-- Biến lưu trữ cấu hình
local TargetPetName = ""
local TargetPetAmount = 0
local IsAutoGetActive = false
local LocalPlayer = game.Players.LocalPlayer

-- TAB CHÍNH: AUTO STEAL PET
local MainTab = Window:MakeTab({
    Name = "Auto Steal",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false
})

MainTab:AddSection({
    Name = "Cấu Hình Pet & Tiền"
})

-- Ô nhập Tên Pet
MainTab:AddTextbox({
    Name = "Tên Pet Muốn Lấy",
    Default = "",
    TextDisappear = false,
    Callback = function(Value)
        TargetPetName = Value
        print("Đã chọn Pet:", TargetPetName)
    end
})

-- Ô nhập Số Tiền
MainTab:AddTextbox({
    Name = "Số Tiền / Giá Trị Pet",
    Default = "0",
    TextDisappear = false,
    Callback = function(Value)
        TargetPetAmount = tonumber(Value) or 0
        print("Số tiền mong muốn:", TargetPetAmount)
    end
})

-- Toggle Kích Hoạt Auto
MainTab:AddToggle({
    Name = "Bật Auto Dịch Chuyển & Lấy Pet",
    Default = false,
    Callback = function(Value)
        IsAutoGetActive = Value
        if IsAutoGetActive then
            OrionLib:MakeNotification({
                Name = "Đã Bật Auto!",
                Content = "Đang quét pet: " .. TargetPetName,
                Image = "rbxassetid://4483345998",
                Time = 3
            })
            
            -- Chạy luồng Auto Teleport & Grab
            task.spawn(function()
                while IsAutoGetActive do
                    local character = LocalPlayer.Character
                    if character and character:FindFirstChild("HumanoidRootPart") then
                        local savedCFrame = character.HumanoidRootPart.CFrame -- Lưu vị trí gốc ban đầu
                        
                        -- Tìm kiếm Pet/Trứng trong Workspace (Tùy thuộc vào model game Steal an Egg)
                        local targetEggOrPet = nil
                        for _, obj in pairs(workspace:GetDescendants()) do
                            if obj:IsA("Model") or obj:IsA("BasePart") then
                                if string.find(string.lower(obj.Name), string.lower(TargetPetName)) and TargetPetName ~= "" then
                                    targetEggOrPet = obj
                                    break
                                end
                            end
                        end

                        if targetEggOrPet then
                            local targetPos = targetEggOrPet:IsA("Model") and targetEggOrPet:GetPivot() or targetEggOrPet.CFrame
                            
                            -- 1. Teleport đến Pet
                            character.HumanoidRootPart.CFrame = targetPos + Vector3.new(0, 3, 0)
                            task.wait(0.5) -- Đợi nhặt pet
                            
                            -- 2. Thực hiện hành động tương tác (Ví dụ nhấp/ProximityPrompt)
                            for _, prompt in pairs(targetEggOrPet:GetDescendants()) do
                                if prompt:IsA("ProximityPrompt") then
                                    fireproximityprompt(prompt)
                                end
                            end
                            
                            task.wait(0.5)
                            
                            -- 3. Auto bay về vị trí ban đầu
                            character.HumanoidRootPart.CFrame = savedCFrame
                            OrionLib:MakeNotification({
                                Name = "Thành công!",
                                Content = "Đã lấy xong pet và bay về căn cứ!",
                                Image = "rbxassetid://4483345998",
                                Time = 2
                            })
                        end
                    end
                    task.wait(2) -- Khoảng thời gian giữa mỗi lần quét
                end
            end)
        end
    end
})

-- TAB THÔNG TIN NGƯỜI CHƠI

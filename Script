-- Demo data: replace with data from an authorized game interface
local Eggs = {
    {name = "Divine Egg", rarity = 5, price = "Divine"},
    {name = "Secret Egg", rarity = 4, price = "Secret"},
    {name = "Mythic Egg", rarity = 3, price = "Mythic"},
    {name = "Legendary Egg", rarity = 2, price = "Legendary"},
    {name = "Rare Egg", rarity = 1, price = "Rare"}
}

local function render()
    for _, child in ipairs(List:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    for _, egg in ipairs(Eggs) do
        local item = makeButton(
            List,
            egg.name .. "  |  " .. egg.price,
            UDim2.new(1, -8, 0, 42),
            UDim2.new()
        )
        item.TextSize = 12
        item.MouseButton1Click:Connect(function()
            print("Selected:", egg.name)
        end)
    end

    List.CanvasSize = UDim2.fromOffset(
        0, #Eggs * 49
    )
end

Sort.MouseButton1Click:Connect(function()
    table.sort(Eggs, function(a, b)
        return a.rarity > b.rarity
    end)
    render()
end)

Filter.MouseButton1Click:Connect(function()
    Filter.Text = Filter.Text == "EGGS: ALL"
        and "EGGS: DIVINE" or "EGGS: ALL"
end)

OpenPanel.MouseButton1Click:Connect(function()

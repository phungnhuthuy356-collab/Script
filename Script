-- ====================================================================
-- TELEPORT & EGG STEAL EXECUTION LOGIC
-- ====================================================================
local function FindTargetInstance(name)
    for _, obj in ipairs(CoreServices.Workspace:GetDescendants()) do
        if obj.Name == name or obj.Name:find(name) then
            if obj:IsA("BasePart") then return obj end
            if obj:IsA("Model") then return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart") end
        end
    end
    return nil
end

local function FireInteractPrompts(target)
    for _, prompt in ipairs(target:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            fireproximityprompt(prompt)
        end
    end
end

TeleportBtn.MouseButton1Click:Connect(function()
    if Config.SelectedEgg == "" then
        StatusLog.Text = "Vui lòng chọn Trứng/Đảo trước!"
        StatusLog.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end

    if not RootPart or not Character then return end

    StatusLog.Text = "Đang lưu vị trí nhà gốc..."
    StatusLog.TextColor3 = Color3.fromRGB(255, 215, 0)
    Config.SavedPosition = RootPart.CFrame

    local targetPart = FindTargetInstance(Config.SelectedEgg)

    if targetPart then
        StatusLog.Text = "Đang dịch chuyển đến: " .. Config.SelectedEgg
        StatusLog.TextColor3 = Color3.fromRGB(0, 229, 255)

        -- Smooth Teleport
        local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local tween = CoreServices.TweenService:Create(RootPart, tweenInfo, {CFrame = targetPart.CFrame * CFrame.new(0, 3, 0)})
        tween:Play()
        tween.Completed:Wait()

        task.wait(0.2)
        StatusLog.Text = "Đang lấy trứng..."
        FireInteractPrompts(targetPart.Parent or targetPart)

        task.wait(Config.StealSpeed)

        -- Teleport back home
        StatusLog.Text = "Bay về lại căn cứ..."
        if Config.SavedPosition then
            local returnTween = CoreServices.TweenService:Create(RootPart, tweenInfo, {CFrame = Config.SavedPosition})
            returnTween:Play()
            returnTween.Completed:Wait()
        end

        StatusLog.Text = "Hoàn tất cướp trứng thành công!"
        StatusLog.TextColor3 = Color3.fromRGB(100, 255, 100)
    else
        StatusLog.Text = "Không tìm thấy tọa độ mục tiêu!"
        StatusLog.TextColor3 = Color3.fromRGB(255, 50, 50)
    end
end)


-- Cập nhật trạng thái người chơi liên tục
task.spawn(function()
    while task.wait(1) do
        if IsAutoGetActive then
            StatusLabel:Set("Trạng thái Auto: 🟢 ĐANG CHẠY (" .. TargetPetName .. ")")
        else
            StatusLabel:Set("Trạng thái Auto: 🔴 ĐÃ TẮT")
        end
    end
end)


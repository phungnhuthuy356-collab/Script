-- [[ CUSTOM FLOATING UI & STEAL PANEL - TIKTOK: lauca ]] --
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Xóa GUI cũ nếu đã tồn tại để tránh trùng lặp khi test
if CoreGui:FindFirstChild("LauCaCustomHub") then
    CoreGui.FindFirstChild("LauCaCustomHub"):Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "LauCaCustomHub"
ScreenGui.Parent = CoreGui
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

-- 1. TẠO THANH FLOATING TOGGLE CHÍNH (Giống khung dài có icon lửa ở giữa màn hình)
local MainToggleFrame = Instance.new("Frame")
MainToggleFrame.Name = "MainToggleFrame"
MainToggleFrame.Parent = ScreenGui
MainToggleFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
MainToggleFrame.BackgroundTransparency = 0.2
MainToggleFrame.Position = UDim2.new(0.5, -110, 0.75, 0)
MainToggleFrame.Size = UDim2.new(0, 220, 0, 45)
MainToggleFrame.BorderSizePixel = 0

local UICornerMain = Instance.new("UICorner")
UICornerMain.CornerRadius = UDim.new(1, 0) -- Bo tròn dạng viên thuốc (pill shape)
UICornerMain.Parent = MainToggleFrame

-- Icon / Text hiển thị trạng thái
local StatusText = Instance.new("TextLabel")
StatusText.Parent = MainToggleFrame
StatusText.BackgroundTransparency = 1
StatusText.Position = UDim2.new(0, 45, 0, 0)
StatusText.Size = UDim2.new(0, 110, 1, 0)
StatusText.Font = Enum.Font.SourceSansBold
StatusText.Text = "Auto Steal: OFF"
StatusText.TextColor3 = Color3.fromRGB(255, 255, 255)
StatusText.TextSize = 14

-- Nút Toggle Bật/Tắt (Màu đỏ/xanh)
local ToggleButton = Instance.new("TextButton")
ToggleButton.Parent = MainToggleFrame
ToggleButton.BackgroundColor3 = Color3.fromRGB(230, 50, 50) -- Đỏ (Off)
ToggleButton.Position = UDim2.new(1, -55, 0.5, -15)
ToggleButton.Size = UDim2.new(0, 45, 0, 30)
ToggleButton.Text = ""

local UICornerBtn = Instance.new("UICorner")
UICornerBtn.CornerRadius = UDim.new(1, 0)
UICornerBtn.Parent = ToggleButton

local isRunning = false
ToggleButton.MouseButton1Click:Connect(function()
    isRunning = not isRunning
    if isRunning then
        ToggleButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50) -- Xanh (On)
        StatusText.Text = "Auto Steal: ON"
    else
        ToggleButton.BackgroundColor3 = Color3.fromRGB(230, 50, 50) -- Đỏ (Off)
        StatusText.Text = "Auto Steal: OFF"
    end
end)


-- 2. TẠO BẢNG "STEAL PANEL" BÊN PHẢI (Giống khung danh sách pet trong hình)
local StealPanel = Instance.new("Frame")
StealPanel.Name = "StealPanel"
StealPanel.Parent = ScreenGui
StealPanel.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
StealPanel.BackgroundTransparency = 0.1
StealPanel.Position = UDim2.new(1, -210, 0.3, 0)
StealPanel.Size = UDim2.new(0, 200, 0, 250)
StealPanel.BorderSizePixel = 0

local UICornerPanel = Instance.new("UICorner")
UICornerPanel.CornerRadius = UDim.new(0, 8)
UICornerPanel.Parent = StealPanel

-- Tiêu đề Panel
local PanelTitle = Instance.new("TextLabel")
PanelTitle.Parent = StealPanel
PanelTitle.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
PanelTitle.Size = UDim2.new(1, 0, 0, 30)
PanelTitle.Font = Enum.Font.SourceSansBold
PanelTitle.Text = "Steal Panel [Sort: Best Rarity]"
PanelTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
PanelTitle.TextSize, PanelTitle.BorderSizePixel = 13, 0

local UICornerTitle = Instance.new("UICorner")
UICornerTitle.CornerRadius = UDim.new(0, 8)
UICornerTitle.Parent = PanelTitle

-- Nút thu nhỏ/đóng panel (Nút kiểu chữ X hoặc mũi tên bên phải)
local ClosePanelBtn = Instance.new("TextButton")
ClosePanelBtn.Parent = StealPanel
ClosePanelBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
ClosePanelBtn.Position = UDim2.new(1, -25, 0, 5)
ClosePanelBtn.Size = UDim2.new(0, 20, 0, 20)
ClosePanelBtn.Text = "X"
ClosePanelBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ClosePanelBtn.Font = Enum.Font.SourceSansBold
ClosePanelBtn.TextSize = 12

local isOpen = true
ClosePanelBtn.MouseButton1Click:Connect(function()
    isOpen = not isOpen
    for _, child in pairs(StealPanel:GetChildren()) do
        if child ~= PanelTitle and child ~= ClosePanelBtn and child:IsA("GuiObject") then
            child.Visible = isOpen
        end
    end
    StealPanel.Size = isOpen and UDim2.new(0, 200, 0, 250) or UDim2.new(0, 200, 0, 30)
end)

print("LauCa Custom UI Loaded Successfully!")


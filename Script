-- Hàm tạo các nút chức năng
local function createButton(name, posY, callback)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Parent = MainFrame
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 90)
    btn.Position = UDim2.new(0.1, 0, 0, posY)
    btn.Size = UDim2.new(0.8, 0, 0, 40)
    btn.Font = Enum.Font.GothamSemibold
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 13

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    local active = false
    btn.MouseButton1Click:Connect(function()
        active = not active
        if active then
            btn.BackgroundColor3 = Color3.fromRGB(46, 204, 113) -- Đổi sang màu xanh khi bật
        else
            btn.BackgroundColor3 = Color3.fromRGB(60, 60, 90)
        end
        callback(active)
    end)
end

-- Trạng thái các tính năng
local autoCollect = false
local speedHack = false
local espEggs = false

-- 1. Tính năng Auto Collect Egg (Tự động nhặt trứng xung quanh)
createButton("Auto Collect Eggs", 60, function(state)
    autoCollect = state
    task.spawn(function()
        while autoCollect do
            task.wait(0.5)
            pcall(function()
                for _, obj in pairs(Workspace:GetDescendants()) do
                    if obj:IsA("Model") and obj.Name:lower():find("egg") then
                        if obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("BasePart") then
                            local targetPart = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("BasePart")
                            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                                LocalPlayer.Character.HumanoidRootPart.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
                            end
                        end
                    end
                end
            end)
        end
    end)
end)

-- 2. Tính năng Speed Hack (Chạy siêu tốc)
createButton("Super Speed (WalkSpeed)", 115, function(state)
    speedHack = state
    RunService.RenderStepped:Connect(function()
        if speedHack and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            LocalPlayer.Character.Humanoid.WalkSpeed = 35 -- Tốc độ siêu nhanh
        elseif not speedHack and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            LocalPlayer.Character.Humanoid.WalkSpeed = 16 -- Mặc định
        end
    end)
end)

-- 3. Tính năng ESP Eggs (Nhìn xuyên tường thấy vị trí Trứng)
createButton("ESP Eggs (Highlight)", 170, function(state)
    espEggs = state
    while espEggs do
        task.wait(1)
        pcall(function()
            for _, obj in pairs(Workspace:GetDescendants()) do
                if obj:IsA("Model") and obj.Name:lower():find("egg") then
                    if not obj:FindFirstChild("Highlight_Egg") then
                        local highlight = Instance.new("Highlight")
                        highlight.Name = "Highlight_Egg"
                        highlight.Adornee = obj
                        highlight.FillColor = Color3.fromRGB(255, 215, 0) -- Màu vàng kim
                        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                        highlight.Parent = obj
                    end
                end
            end
        end)
    end
    -- Xóa highlight khi tắt
    if not espEggs then
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") and obj:FindFirstChild("Highlight_Egg") then
                obj.Highlight_Egg:Destroy()
            end
        end
    end
end)


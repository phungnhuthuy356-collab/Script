-- Gọi thư viện giao diện Venyx UI Library
local Venyx = loadstring(game:HttpGet("https://raw.githubusercontent.com/GreenD1st/Venyx-UI-Library/main/source.lua"))()
local window = Venyx.new("Venyx x Chilli | Steal An Egg")

-- Tạo các Tab (Trang chủ, Tính năng, Cài đặt)
local tab1 = window:addPage("Trang Chủ", 6023426915) -- Thay ID icon nếu muốn
local tab2 = window:addPage("Auto Steal", 6023426915)
local tab3 = window:addPage("Cài Đặt", 6023426915)

-- 1. Trang chủ: Hiển thị thông tin tài khoản giống ảnh
local homeSection = tab1:addSection("Thông tin người chơi")
homeSection:addLabel("Tên tài khoản: " .. game.Players.LocalPlayer.Name)
homeStatusLabel = homeSection:addLabel("Trạng thái: Đang kết nối (No Key)")

homeSection:addToggle("Anti Guard (Chống bảo vệ)", false, function(value)
    print("Anti Guard:", value)
    -- Viết code bật/tắt chống bảo vệ tại đây
end)

-- 2. Tab Auto Steal: Các tính năng chính để trộm trứng
local stealSection = tab2:addSection("Tính năng chính")

stealSection:addToggle("Auto Steal Eggs (Tự động trộm trứng)", false, function(value)
    _G.AutoSteal = value
    task.spawn(function()
        while _G.AutoSteal do
            task.wait(0.5)
            pcall(function()
                -- Code dịch chuyển hoặc tương tác với trứng ở đây
                for _, obj in pairs(workspace:GetChildren()) do
                    if obj.Name:lower():find("egg") and obj:FindFirstChild("TouchInterest") then
                        game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = obj.CFrame
                    end
                end
            end)
        end
    end)
end)

stealSection:addToggle("Teleport to Egg (Dịch chuyển đến trứng)", false, function(value)
    print("Teleport to Egg:", value)
end)

stealSection:addButton("Discord Venyx", function()
    setclipboard("https://discord.gg/venyx") -- Copy link discord vào bộ nhớ tạm
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Thông báo",
        Text = "Đã sao chép link Discord!",
        Duration = 3
    })
end)

-- 3. Tab Cài đặt
local settingSection = tab3:addSection("Hệ thống")
settingSection:addButton("Đóng Menu / Hủy Script", function()
    window:Teardown() -- Đóng UI
end)

-- Hiển thị thông báo khi load xong script
game:GetService("StarterGui"):SetCore("SendNotification", {
    Title = "Chilli Hub",
    Text = "Load giao diện thành công!",
    Duration = 4
})

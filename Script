local function Label(parent, text, size, pos)
    local obj = Instance.new("TextLabel")
    obj.Size = size
    obj.Position = pos
    obj.BackgroundTransparency = 1
    obj.Text = text
    obj.TextColor3 = White
    obj.TextSize = 16
    obj.Font = Enum.Font.GothamBold
    obj.Parent = parent
    return obj
end


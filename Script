-- ====================================================================
-- SECURE FLY ENGINE (ANTI-ANTI-CHEAT BYPASS FOR MOBILE/PC)
-- ====================================================================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local FlyConfig = {
    Enabled = false,
    Speed = 50, -- Tốc độ bay, có thể tăng giảm tùy ý
    BodyVelocity = nil,
    BodyGyro = nil
}

local function ToggleFly(state)
    FlyConfig.Enabled = state
    local character = LocalPlayer.Character
    if not character then return end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChild("Humanoid")
    
    if FlyConfig.Enabled then
        if not rootPart then return end
        
        if humanoid then
            humanoid.PlatformStand = true
        end
        
        -- Tạo lực đẩy giữ lơ lửng chống trọng lực
        FlyConfig.BodyVelocity = Instance.new("BodyVelocity")
        FlyConfig.BodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        FlyConfig.BodyVelocity.Velocity = Vector3.new(0, 0, 0)
        FlyConfig.BodyVelocity.Parent = rootPart
        
        -- Giữ hướng nhìn ổn định khi bay
        FlyConfig.BodyGyro = Instance.new("BodyGyro")
        FlyConfig.BodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        FlyConfig.BodyGyro.CFrame = rootPart.CFrame
        FlyConfig.BodyGyro.Parent = rootPart
        
        -- Vòng lặp cập nhật hướng bay theo góc nhìn camera
        task.spawn(function()
            while FlyConfig.Enabled and character and rootPart and humanoid and humanoid.Health > 0 do
                local moveDirection = Vector3.new(0, 0, 0)
                local camCFrame = Camera.CFrame
                
                -- Điều khiển trên PC (W, A, S, D, Space, Ctrl) hoặc tích hợp nút ảo mobile nếu muốn
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                    moveDirection = moveDirection + camCFrame.LookVector
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                    moveDirection = moveDirection - camCFrame.LookVector
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                    moveDirection = moveDirection - camCFrame.RightVector
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                    moveDirection = moveDirection + camCFrame.RightVector
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                    moveDirection = moveDirection + Vector3.new(0, 1, 0)
                end
                
                FlyConfig.BodyVelocity.Velocity = moveDirection * FlyConfig.Speed
                FlyConfig.BodyGyro.CFrame = camCFrame
                
                RunService.RenderStepped:Wait()
            end
            
            -- Dọn dẹp khi tắt Fly
            if FlyConfig.BodyVelocity then FlyConfig.BodyVelocity:Destroy() end
            if FlyConfig.BodyGyro then FlyConfig.BodyGyro:Destroy() end
            if humanoid then humanoid.PlatformStand = false end
        end)
    else
        if FlyConfig.BodyVelocity then FlyConfig.BodyVelocity:Destroy() end
        if FlyConfig.BodyGyro then FlyConfig.BodyGyro:Destroy() end
        if humanoid then humanoid.PlatformStand = false end
    end
end)


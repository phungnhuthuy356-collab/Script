-- ====================================================================
-- ANTI-KNOCKBACK & NO-DROP PROTECTION ENGINE
-- ====================================================================
local function ApplyProtection()
    CoreServices.RunService.Heartbeat:Connect(function()
        if Config.AntiKnockback and Character and Character:FindFirstChild("HumanoidRootPart") then
            -- Set linear velocity stabilization to counteract monster impulses
            local root = Character.HumanoidRootPart
            local velocity = root.AssemblyLinearVelocity
            root.AssemblyLinearVelocity = Vector3.new(0, math.clamp(velocity.Y, -50, 50), 0)

            -- Prevent ragdoll or falling states
            if Humanoid then
                Humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                Humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                Humanoid:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)
            end
        end

        if Config.PreventDrop and Character then
            -- Lock tools/eggs in character hierarchy to prevent dropping on hit
            for _, item in ipairs(Character:GetChildren()) do
                if item:IsA("Tool") or item.Name:lower():find("egg") then
                    item.CanBeDropped = false
                end
            end
        end
    end)
end
ApplyProtection()

-- ====================================================================
-- ENVIRONMENT SCANNERS
-- ====================================================================
local function ScanMapEntities()
    table.clear(EggLocations)

    -- Scan workspace for Eggs or Islands
    local searchContainers = {
        CoreServices.Workspace:FindFirstChild("Eggs"),
        CoreServices.Workspace:FindFirstChild("Islands"),
        CoreServices.Workspace:FindFirstChild("Map"),
        CoreServices.Workspace
    }

    for _, container in ipairs(searchContainers) do
        if container then
            for _, obj in ipairs(container:GetDescendants()) do
                if obj:IsA("Model") or obj:IsA("BasePart") then
                    local name = obj.Name
                    if name:lower():find("egg") or name:lower():find("island") or obj:FindFirstChildOfClass("ProximityPrompt") then
                        if not table.find(EggLocations, name) then
                            table.insert(EggLocations, name)
                        end
                    end
                end
            end
        end
    end

    if #EggLocations == 0 then
        EggLocations = {"Trứng Thường", "Trứng Hiếm", "Trứng Huyền Thoại", "Đảo Rồng", "Đảo Băng"}
    end
end
ScanMapEntities()

-- Helper to get player's money
local function GetPlayerMoney()
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        local coin = leaderstats:FindFirstChild("Coins") or leaderstats:FindFirstChild("Money") or leaderstats:FindFirstChild("Cash") or leaderstats:FindFirstChild("Gems")
        if coin then return tostring(coin.Value) end
    end
    return "0"
end

